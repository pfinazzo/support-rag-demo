{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "rootDir": "client",
    "outDir": "public",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["client/**/*.ts", "client/**/*.d.ts"],
  "exclude": ["node_modules"]
}
