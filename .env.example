# Copy to .env:
#   cp .env.example .env
#
# Instant demo (mock embeddings + mock LLM):
#   npm run index:mock && npm run demo
# Then click “Login with Local Claude” to upgrade Stage 5 to your Claude Code CLI
# while keeping mock/OpenAI embeddings + local MiniLM re-ranker.

# OpenAI — embeddings (text-embedding-3-small). Absent → MOCK_AI embeddings.
OPENAI_API_KEY=

# Anthropic Messages API (optional if using Local Claude CLI)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: force Cohere rerank-v3.5 instead of local Xenova MiniLM
COHERE_API_KEY=
# COHERE_RERANK_MODEL=rerank-v3.5

# Local Claude Code CLI
# CLAUDE_CLI_PATH=/Users/you/.nvm/versions/node/v20.20.2/bin/claude
# CLAUDE_LOCAL_MODEL=
# FORCE_MOCK_LLM=true

# Hybrid search + re-ranker
MIN_VECTOR_SIMILARITY=0.25
MIN_RERANK_SCORE=-2.5
SHORTLIST_TOP_K=8
FINAL_TOP_K=3

# ---------------------------------------------------------------------------
# Pinecone Vector Database (Role-Based Access Control (RBAC) metadata filter)
# ---------------------------------------------------------------------------
# When PINECONE_API_KEY is set the app upserts/queries a live Pinecone Cloud
# serverless cosine index (Hierarchical Navigable Small World (HNSW) / serverless)
# with metadata filter: { "roles": { "$in": [<caller roles>] } }.
#
# When PINECONE_API_KEY is empty the zero-key local simulator at
# data/pinecone.mock.json applies the EXACT same filter before scoring.
#
PINECONE_API_KEY=
PINECONE_INDEX=support-rag-demo
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

PORT=3000

# Dedicated local Prompt Guard classifier (independent of MOCK_AI).
# Warm-starts pinned Llama Prompt Guard 2 22M FP32 ONNX; ~270 MB first download.
# TRANSFORMERS_CACHE=./.cache/transformers
# FORCE_MOCK_GUARD=false
# Only npm test enables FORCE_MOCK_GUARD=true; live failures fail closed.
# Optional OpenAI answer generation (embeddings can remain mocked):
# LLM_PROVIDER=openai
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Post-generation local DeBERTa NLI is live even with MOCK_AI=true.
# FORCE_MOCK_NLI=false
# npm test mocks routine citation checks but explicitly runs real NLI negation tests.
